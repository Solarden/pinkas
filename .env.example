# The web app and the pull script read these. Keep the real file outside the repo, mode 0600.
# Any database works: every table is prefixed pinkas_ and Alembic keeps its own version table, so a
# database shared with other apps is fine.
# The app role, shared by the web app and the pull: the pull ingests and purges raw files.
DATABASE_URL=postgresql://pinkas:CHANGE_ME@127.0.0.1:5432/pinkas
# The table owner: migrations and --set-password only, never the web app.
# `alembic upgrade head` reads it from the environment, or from this file when PINKAS_ENV holds its path.
MIGRATE_DATABASE_URL=postgresql://pinkas_owner:CHANGE_ME@127.0.0.1:5432/pinkas
# HMAC key for session cookies and form tokens; rotating it logs everyone out.
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=CHANGE_ME
# A command whose stdout is the addon's SavedVariables file, e.g. `cat` of a local copy or an ssh
# command. The pull splits it like a shell would (shlex) but never runs a shell.
PINKAS_SOURCE="cat Pinkas.lua"
# Optional: host:port to check before running the source. No answer within 3 s means "the gaming PC is
# asleep": the run ends quietly instead of logging a failure.
PINKAS_PROBE=
# Optional: a markdown file shown at /guide.
PINKAS_GUIDE=
